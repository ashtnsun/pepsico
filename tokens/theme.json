            "codeSyntax": {
              "WEB": "var(--color-brand-accent)"
            },
            "scopes": [
              "FRAME_FILL",
              "SHAPE_FILL"
            ],
            "modes": {
              "JOY": "{joy.sky.300}",
              "Doritos": "{doritos.orange.500}",
              "Rockstar": "{rockstar.violet.500}"
            }
          }
        }
      }
    },
    "feedback": {
      "active": {
        "$type": "color",
        "$value": "{joy.green.300}",
        "$description": "Active badge background (D15).",
        "$extensions": {
          "com.figma": {
            "codeSyntax": {
              "WEB": "var(--color-feedback-active)"
            },
            "scopes": [
              "FRAME_FILL",
              "SHAPE_FILL"
            ],
            "modes": {
              "JOY": "{joy.green.300}",
              "Doritos": "{joy.green.300}",
              "Rockstar": "{joy.green.300}"
            }
          }
        }
