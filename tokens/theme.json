    "brand": {
      "primary": {
        "$type": "color",
        "$value": "{joy.blue.500}",
        "$description": "Main brand color for brand areas, e.g. step circles. Not for buttons.",
        "$extensions": {
          "com.figma": {
            "codeSyntax": {
