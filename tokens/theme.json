  "font": {
    "family": {
      "body": {
        "$type": "fontFamily",
        "$value": "{font.family.brand}",
        "$description": "Font family for all text.",
        "$extensions": {
          "com.figma": {
            "codeSyntax": {
              "WEB": "var(--font-family-body)"
            },
            "scopes": [
              "FONT_FAMILY"
            ],
            "modes": {
              "JOY": "{font.family.brand}",
              "Doritos": "{font.family.brand}",
              "Rockstar": "{font.family.brand}"
            }
          }
        }
      }
    }
  }
}
